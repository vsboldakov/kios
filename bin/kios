#!/bin/sh
set -e

source=$0
while [ -L "$source" ]; do
  dir=$(dirname -- "$source")
  source=$(readlink -- "$source")
  case $source in
    /*) ;;
    *) source=$dir/$source ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname -- "$source")/.." && pwd)

if command -v bun >/dev/null 2>&1; then
  bun_bin=$(command -v bun)
elif [ -x "$HOME/.bun/bin/bun" ]; then
  bun_bin=$HOME/.bun/bin/bun
else
  echo "kios needs bun: https://bun.sh" >&2
  exit 1
fi

exec "$bun_bin" --config="$root/bunfig.toml" "$root/src/index.tsx" "$@"
