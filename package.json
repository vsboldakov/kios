{
  "name": "@vsboldakov/kios",
  "version": "0.1.0",
  "description": "Terminal UI for Kubernetes workloads",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "kios": "src/index.tsx"
  },
  "files": [
    "src",
    "tsconfig.json",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "engines": {
    "bun": ">=1.3.5"
  },
  "scripts": {
    "start": "bun src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "@opentui/solid": "0.9.0",
    "@solid-primitives/keyed": "1.5.3",
    "@solid-primitives/map": "0.7.4",
    "@solid-primitives/timer": "1.4.4",
    "solid-js": "1.9.19"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}
