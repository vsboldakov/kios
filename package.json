{
  "name": "@vsboldakov/kios",
  "version": "0.7.0",
  "description": "Kubernetes TUI: a k8s terminal UI for kubectl to browse clusters, logs, exec and port-forward",
  "keywords": [
    "kubernetes",
    "k8s",
    "kubectl",
    "tui",
    "terminal-ui",
    "kubernetes-ui",
    "k8s-ui",
    "kubernetes-dashboard",
    "k9s-alternative",
    "lens-alternative",
    "devops",
    "cli"
  ],
  "homepage": "https://github.com/vsboldakov/kios",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vsboldakov/kios.git"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "kios": "bin/kios"
  },
  "files": [
    "bin",
    "src",
    "tsconfig.json",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "engines": {
    "bun": ">=1.3.5"
  },
  "scripts": {
    "start": "bun src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "@opentui/solid": "0.9.0",
    "@solid-primitives/keyed": "1.5.3",
    "@solid-primitives/map": "0.7.4",
    "@solid-primitives/timer": "1.4.4",
    "arg": "5.0.2",
    "solid-js": "1.9.19"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}
